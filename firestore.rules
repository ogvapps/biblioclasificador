rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// Firestore Security Rules — BiblioClasificador
//
// La app es offline-first: el PIN abre la interfaz en cada dispositivo y la
// sincronización con la nube exige una cuenta de Firebase Auth (Ajustes →
// Cuenta de la nube). Cada cuenta tiene un documento users/{uid} con
// { role: 'ADMIN' | 'ASSISTANT' }, creado desde la consola de Firebase;
// nadie puede asignarse un rol desde la app.
//
// Aplicar: consola de Firebase → Firestore → Reglas → pegar → Publicar,
// o `npx firebase-tools deploy --only firestore:rules`.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && role() == 'ADMIN';
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && role() in ['ADMIN', 'ASSISTANT'];
    }

    // Campos que cambian al prestar, devolver y reservar (LoanModal,
    // ReturnModal, ReservationModal). El resto del libro solo lo edita el admin.
    function onlyCirculationFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['currentLoanId', 'status', 'condition', 'reservation', 'rating', 'totalRatings']);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // El catálogo es público (modo alumno); gestionarlo es cosa del admin
    match /books/{bookId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isStaff() && onlyCirculationFields());
    }

    // Préstamos y alumnos contienen datos personales de menores
    match /loans/{loanId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasAll(['id', 'bookId', 'studentName', 'status'])
        && request.resource.data.id == loanId
        && request.resource.data.status in ['ACTIVE', 'RETURNED'];
      allow delete: if false; // Los préstamos no se borran, solo se marcan RETURNED
    }

    match /students/{studentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
